# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE/editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local database files
data/*.db
*.sqlite
*.sqlite3

# Local runtime and sensitive files
*.log
*.bak
*.tmp

# Optional local media/signature outputs
firmas/*
imagenes/*
!firmas/.gitkeep
!imagenes/.gitkeep

# Local config overrides
config.local.json
.env
.env.*
